{
  "name": "@ttmouse/dsh-generative-ui",
  "version": "0.1.0",
  "description": "dsh-generative-ui：让 AI 在 DSH 对话流里直接输出可交互的 HTML 组件（Generative UI）。agent 在回复里写 ```generative-ui 围栏（内容为自包含 HTML），客户端把每轮回答里的工件提取出来，沙箱渲染成内嵌的可交互 UI。纯客户端实现，零后端、零存储——工件就活在消息文本里，会话在它就在。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttmouse/dsh-generative-ui.git"
  },
  "homepage": "https://github.com/ttmouse/dsh-generative-ui#readme",
  "bugs": {
    "url": "https://github.com/ttmouse/dsh-generative-ui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "generative-ui",
    "artifacts",
    "interactive-html",
    "web",
    "cordis",
    "ai-agent"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "npm run build && node --test tests/logic.test.mjs && node tests/e2e/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "license": "MIT"
}
